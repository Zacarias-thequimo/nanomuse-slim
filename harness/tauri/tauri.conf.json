{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nanoMuse",
  "version": "0.1.40",
  "identifier": "io.github.nanomuse.desktop",
  "build": {
    "frontendDist": "../tauri/frontend",
    "devUrl": "http://127.0.0.1:38421",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "nanoMuse",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["../desktop/resources/icons/256x256.png"],
    "category": "Utility",
    "shortDescription": "An open-source personal agent for every device you own",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "xdotool"]
      }
    },
    "resources": ["dsh"]
  }
}
